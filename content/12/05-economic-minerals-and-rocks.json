  "topics": [
    {
      "id": "12-05-intro",
      "title": "Introduction and Terminology",
      "slug": "introduction-and-terminology",
      "order": 1,
      "estimatedMinutes": 10,
      "blocks": [
        {
          "id": "12-05-b001",
          "type": "definition",
          "depth": 1,
          "title": "Economic Geology",
          "body": "The branch of Geology that deals with the exploration, exploitation and origin of economically important minerals from the earth.",
          "source": {
            "type": "notes",
            "ref": "notes p.1"
          },
          "verified": true,
          "tags": [
            "economic geology",
            "definition"
          ]
        },
        {
          "id": "12-05-b002",
          "type": "definition",
          "depth": 1,
          "title": "Ore",
          "body": "A natural concentration of one or more minerals, i.e. rock from which one or more metals can be extracted economically.",
          "source": {
            "type": "textbook",
            "ref": "p.66"
          },
          "verified": true,
          "tags": [
            "ore",
            "definition"
          ]
        },
        {
          "id": "12-05-b003",
          "type": "definition",
          "depth": 2,
          "title": "Ore Deposit vs Ore Mineral",
          "body": "**Ore deposit** is a rock which consists of ore minerals and rock forming minerals. (e.g. Dunite is an ultrabasic igneous rock which contains olivine as a rock forming mineral & chromite as an ore mineral). \n\n**Ore minerals** are those minerals from which one or more metals can be extracted.",
          "source": {
            "type": "notes",
            "ref": "notes p.1"
          },
          "verified": true,
          "tags": [
            "ore deposit",
            "ore mineral"
          ]
        },
        {
          "id": "12-05-b004",
          "type": "list",
          "depth": 2,
          "title": "Types of Ore Minerals",
          "items": [
            "**Simple Ore Mineral**: When one metal can be extracted from the ore deposit (e.g., Iron from Hematite/Magnetite, Aluminium from Bauxite).",
            "**Complex Ore Mineral**: When more than one metal can be extracted from the ore deposit (e.g., Chalcopyrite contains Cu and Fe)."
          ],
          "source": {
            "type": "notes",
            "ref": "notes p.1-2"
          },
          "verified": true,
          "tags": [
            "simple ore",
            "complex ore"
          ]
        },
        {
          "id": "12-05-b005",
          "type": "definition",
          "depth": 1,
          "title": "Gangue",
          "body": "Gangue comprises of minerals which are associated with the ore but are commercially insignificant at a particular period of time. Commonly silicates, carbonates, or fluorides.",
          "source": {
            "type": "textbook",
            "ref": "p.67"
          },
          "verified": true,
          "tags": [
            "gangue",
            "definition"
          ]
        },
        {
          "id": "12-05-b006",
          "type": "table",
          "depth": 3,
          "title": "Gangue Mineral Associations",
          "headers": [
            "Rock / Deposit",
